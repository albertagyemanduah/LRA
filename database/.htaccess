# ============================================================
# The database folder holds config.php with live credentials.
# Nothing in here should ever be reachable over HTTP.
#
# On cPanel the safest arrangement is to keep this folder ABOVE
# public_html entirely; this file is the belt-and-braces version
# for when it has to sit inside the document root.
# ============================================================

# Apache 2.4+
<IfModule mod_authz_core.c>
    Require all denied
</IfModule>

# Apache 2.2
<IfModule !mod_authz_core.c>
    Order allow,deny
    Deny from all
</IfModule>
