# ============================================================
# TECHIMAN NORTH LAND REGISTRY — ENVIRONMENT VARIABLES TEMPLATE
# Copy this file to .env and fill in your actual values.
# NEVER commit .env to version control.
# ============================================================

# ----- APPLICATION -----
NODE_ENV=production
APP_NAME="Techiman North Land Registry"
APP_URL=https://yourdomain.com
APP_PORT=3000

# ----- POCKETBASE -----
# Internal URL (same server)
PB_URL=http://localhost:8090
# Encryption key — generate with: openssl rand -hex 32
PB_ENCRYPTION_KEY=your_64_char_hex_encryption_key_here
# Superuser credentials (first run only)
PB_SUPERUSER_EMAIL=admin@yourdomain.com
PB_SUPERUSER_PASSWORD=change_this_strong_password

# ----- EXPRESS API -----
API_PORT=3001
# JWT secret — generate with: openssl rand -hex 64
JWT_SECRET=your_jwt_secret_here
# CORS allowed origins (comma-separated)
CORS_ORIGINS=https://yourdomain.com,https://www.yourdomain.com

# ----- ARKESEL SMS API -----
# https://arkesel.com — obtain from your Arkesel dashboard
ARKESEL_API_KEY=your_arkesel_api_key_here
ARKESEL_SMS_SENDER=TeNDA PPD
ARKESEL_BASE_URL=https://sms.arkesel.com/api/v2

# ----- EMAIL (SMTP) -----
# Use your hosting provider's SMTP or an external service
SMTP_HOST=mail.yourdomain.com
SMTP_PORT=465
SMTP_SECURE=true
SMTP_USER=noreply@yourdomain.com
SMTP_PASSWORD=your_smtp_password_here
SMTP_FROM="Techiman North Land Registry <noreply@yourdomain.com>"

# ----- FILE UPLOADS -----
# Max file size in bytes (default 15 MB)
MAX_FILE_SIZE=15728640
# Allowed MIME types (comma-separated)
ALLOWED_MIME_TYPES=application/pdf,image/jpeg,image/png,image/webp,application/msword,application/vnd.openxmlformats-officedocument.wordprocessingml.document

# ----- SESSION -----
# Session secret — generate with: openssl rand -hex 32
SESSION_SECRET=your_session_secret_here
# Session timeout in milliseconds (default 30 min)
SESSION_TIMEOUT_MS=1800000

# ----- RATE LIMITING -----
# Max requests per window
RATE_LIMIT_MAX=100
# Window in milliseconds (15 minutes)
RATE_LIMIT_WINDOW_MS=900000

# ----- LOGGING -----
LOG_LEVEL=info
# Directory for log files (relative to project root)
LOG_DIR=logs

# ----- HPANEL / HOSTINGER SPECIFIC -----
# Set to the absolute path where the app is deployed on HPanel
APP_ROOT=/home/yourusername/public_html
# PocketBase data directory on HPanel
PB_DATA_DIR=/home/yourusername/pb_data
